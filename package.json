{
  "name": "actionsboard-solo",
  "version": "1.3.0",
  "description": "GitHub Actions の実行状態と Pages のデプロイを追跡するコンテキスト指向型ダッシュボード。",
  "scripts": {
    "test": "jest",
    "coverage": "jest --coverage --coverageReporters=json-summary lcov text",
    "version:check": "python3 scripts/check_version.py",
    "screenshots": "python3 scripts/generate_screenshots.py",
    "update-version": "python3 scripts/update_version.py"
  },
  "author": "Masanori SATAKE",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^10.11.0",
    "jest": "^30.5.2"
  }
}
